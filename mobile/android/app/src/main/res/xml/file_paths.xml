<?xml version="1.0" encoding="utf-8"?>
<!-- Paths the ota_update FileProvider may share with Android's package installer.
     ota_update 4.x+ downloads into internal storage under files/ota_update/, so only that
     directory is exposed. Nothing else in the app's storage becomes reachable. -->
<paths>
    <files-path name="internal_apk_storage" path="ota_update/" />
</paths>
