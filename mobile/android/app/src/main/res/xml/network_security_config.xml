<?xml version="1.0" encoding="utf-8"?>
<!-- Release (and profile) builds: HTTPS only, system CAs only.
     Debug builds replace this file with src/debug/res/xml/network_security_config.xml,
     which allows plain HTTP to your laptop for local testing. Keeping cleartext out of
     this file means a release APK can never talk to the API over plain HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
