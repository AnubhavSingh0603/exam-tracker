# Rendered by the nginx image's entrypoint: ${DOMAIN} is substituted from the
# container environment. nginx's own variables ($host, $remote_addr, …) are left
# alone because no environment variables have those names.

limit_req_zone $binary_remote_addr zone=api:10m  rate=10r/s;
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
limit_req_status 429;

upstream fastapi {
    server api:8000;
    keepalive 16;
}

# ---------------------------------------------------------------- HTTP :80
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};
    server_tokens off;

    # Let's Encrypt HTTP-01 challenges (initial issue + renewals)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Container healthcheck; never exposed over HTTPS
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --------------------------------------------------------------- HTTPS :443
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    # No OCSP stapling: Let's Encrypt shut down its OCSP service in 2025.

    # Security headers. Everything here is JSON or APK downloads, so the CSP denies all
    # content types. Declared once at server level: a location block that uses
    # add_header would silently drop all of these.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types application/json text/plain text/css application/javascript;

    client_max_body_size 45m;  # notification PDF uploads (MAX_UPLOAD_MB=40)

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Sign-in / refresh: slow down credential stuffing and token brute force.
    location /api/v1/auth/ {
        limit_req zone=auth burst=10 nodelay;
        proxy_pass http://fastapi;
    }

    location /api/ {
        limit_req zone=api burst=40 nodelay;
        proxy_read_timeout 300s;  # PDF upload waits for Gemini extraction
        proxy_send_timeout 300s;
        proxy_pass http://fastapi;
    }

    location = /healthz {
        access_log off;
        proxy_pass http://fastapi;
    }

    # Self-hosted APK mirror (optional; see scripts/sync_release_manifest.sh)
    location /downloads/ {
        alias /srv/downloads/;
        autoindex off;
        types {
            application/vnd.android.package-archive apk;
            application/json json;
        }
        default_type application/octet-stream;
        expires 10m;
    }

    location / {
        return 404;
    }
}
