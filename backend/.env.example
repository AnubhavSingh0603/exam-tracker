# --- App ---------------------------------------------------------------------
# dev enables /docs
ENVIRONMENT=prod
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# --- Security ----------------------------------------------------------------
# Shared secret the Flutter app sends as the X-API-Key header.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me
# Fernet key for the Credential Vault (portal passwords encrypted at rest).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key = losing every stored portal password. Back it up separately.
VAULT_KEY=change-me
CORS_ORIGINS=[]

# --- PostgreSQL (consumed by both the db container and the API) --------------
POSTGRES_USER=tracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tracker
DATABASE_URL=postgresql+asyncpg://tracker:change-me@db:5432/tracker
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# set false once Alembic migrations are in place
AUTO_CREATE_SCHEMA=true

# --- Gemini (Google AI Studio free tier) -------------------------------------
GEMINI_API_KEY=change-me
# 1.5 Flash is retired; any current Flash model works with the same code.
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_S=180
GEMINI_MAX_ATTEMPTS=5

# --- Uploads -----------------------------------------------------------------
UPLOAD_DIR=/data/notifications
MAX_UPLOAD_MB=40

# --- Domain ------------------------------------------------------------------
# Paralysis Shield, hard-capped at 5
FEED_MAX_ITEMS=5
FEED_SCAN_LIMIT=300
# relaxation users can't claim UR seats
STRICT_UR_MIGRATION=true

# --- Auth (Phase 3) -------------------------------------------------------------
# JSON list of OAuth client IDs allowed as the ID token audience. For Android
# Credential Manager use the *Web application* client ID (your serverClientId).
GOOGLE_CLIENT_IDS=["1234567890-abc.apps.googleusercontent.com"]
# >= 32 random chars:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=60

# --- Crawling (Phase 3) ---------------------------------------------------------
# Honest product token (no browser impersonation). Avoid "bot", URLs and e-mail
# addresses in it: upsc.gov.in's firewall rejects those with 403.
SCRAPER_USER_AGENT=ExamTracker/0.3 (personal exam tracker)
# Optional PEM with extra intermediate CAs for sites with broken TLS chains
# (app/certs/extra_intermediates.pem is always loaded; this adds to it).
# EXTRA_CA_BUNDLE=/srv/extra-ca.pem
# Old state-commission servers (e.g. upsssc.gov.in) need pre-RFC 5746 renegotiation.
# Certificates are still verified either way. Set false to refuse those servers.
TLS_ALLOW_LEGACY_RENEGOTIATION=true
CRAWL_INTERVAL_HOURS=4
CRAWL_JITTER_MINUTES=30
SCHEDULER_TICK_MINUTES=10
PER_HOST_MIN_INTERVAL_S=8
CRAWL_CONCURRENCY=3
FETCH_TIMEOUT_S=25
MAX_PAGE_MB=8
RESPECT_ROBOTS_TXT=true
# Requires building with: docker compose build --build-arg WITH_CHROMIUM=1
PLAYWRIGHT_ENABLED=false
AGGREGATOR_DETAIL_PAGES_PER_RUN=15
# On a source's first crawl, only the newest N items are ingested
SEED_BACKFILL_PER_SOURCE=3
# Gemini free tier: a few PDFs every 15 minutes
INGEST_BATCH_SIZE=4
INGEST_INTERVAL_MINUTES=15
MAX_CUSTOM_SOURCES_PER_USER=20
TELEGRAM_PAGES_PER_CRAWL=2

# --- Production deployment (Phase 4) ---------------------------------------------
# Public hostname with a DNS A record pointing at the VM's public IP.
DOMAIN=tracker.example.com
# Let's Encrypt expiry notices go here.
LETSENCRYPT_EMAIL=you@example.com
# 1 = use the staging CA while testing (avoids rate limits; browsers won't trust it)
LETSENCRYPT_STAGING=0
# owner/repo whose GitHub Releases carry the APKs + latest.json
GITHUB_REPO=owner/exam-tracker
# 1 = also mirror APKs onto this server under https://DOMAIN/downloads/
MIRROR_APKS=0

# --- Push notifications (Phase 4) ------------------------------------------------
# docker-compose.prod.yml mounts ./secrets at /run/secrets and sets
# FIREBASE_CREDENTIALS_FILE=/run/secrets/firebase-service-account.json for you.
FCM_ANDROID_CHANNEL_ID=urgent_deadlines
NOTIFY_INTERVAL_MINUTES=30
URGENT_DEADLINE_HOURS=72
# No pings 22:00-07:00 (TIMEZONE) unless a deadline is < 12 h away
QUIET_HOURS_START=22
QUIET_HOURS_END=7
QUIET_HOURS_OVERRIDE_HOURS=12
