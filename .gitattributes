# Scripts and configs run on Linux (OCI VM, CI). Never check them out with CRLF,
# or bash fails with "$'\r': command not found".
*.sh        text eol=lf
*.template  text eol=lf
*.conf      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Dockerfile  text eol=lf
.env.example text eol=lf
*.pem       text eol=lf
*.jks       binary
*.apk       binary
